# Warbitrer Live Multi-Asset 15m

DATABASE_URL=postgres://postgres:postgres@localhost:5432/warbitrer_live
# Max Postgres connections per process. Keep low in prod because each worker has its own pool.
# Minimum 2: advisory-lock callbacks require a second application connection.
# PG_POOL_MAX=3
# APP_BASIC_AUTH_USER=ops
# APP_BASIC_AUTH_PASSWORD=change-me
# Independent fail-closed gate for new real-money entries. Keep false for scan and shadow.
LIVE_EXECUTION_ALLOWED=false
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DB_MAINTENANCE_INTERVAL_MINUTES=60
# DB_RETENTION_SNAPSHOTS_HOURS=72
# DB_RETENTION_PNL_DAYS=30
# DB_RETENTION_RUN_EVENTS_DAYS=30
# DB_RETENTION_FILLS_DAYS=180
# DB_RETENTION_ORDERS_DAYS=180
# DB_RETENTION_CLOSED_INTENTS_DAYS=180
# DB_RETENTION_SETTLEMENTS_DAYS=365
# DB_RETENTION_BRIDGE_TRANSFERS_DAYS=365

# Kalshi live / demo
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# KALSHI_PRIVATE_KEY_PATH=/etc/warbitrer/kalshi-private-key.pem
# KALSHI_ENV=demo

# Polymarket
# POLY_PRIVATE_KEY=0x...
# POLY_PRIVATE_KEY_PATH=/etc/warbitrer/polymarket-private-key.txt
# Derived via: npm run poly:derive-api-key
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=
# POLY_RELAYER_API_KEY=
# POLY_RELAYER_URL=https://relayer-v2.polymarket.com
# POLY_FUNDER_ADDRESS=0x...
# POLY_SIGNATURE_TYPE=POLY_PROXY
# POLY_AUTO_CONVERT=false
# POLY_AUTO_REDEEM=false
# Required for any live execution and when POLY_AUTO_CONVERT=true. Live accounting
# verifies confirmed Polymarket fills against Polygon OrderFilled events. The worker
# also calls eth_blockNumber at boot and trips a global rpc_unhealthy breaker if the
# RPC is missing or unhealthy.
# POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# Chainlink Data Streams direct (required for BNB/HYPE mismatch risk).
# Obtain sponsored credentials from the Chainlink onboarding linked by Polymarket.
# CHAINLINK_DATA_STREAMS_API_KEY=
# CHAINLINK_DATA_STREAMS_USER_SECRET=

# Strategy
# SHADOW MODE:
# - enableTrading=false, shadowMode=true  => scan only
# - enableTrading=true, shadowMode=true   => shadow execution
# - enableTrading=true, shadowMode=false  => live execution
# POLY_BRIDGE_LOW_WATER_USDC=250

# Worker runtime
# WARBITRER_WORKER_ROLE=legacy
# WARBITRER_WORKER_ASSET=btc
# WARBITRER_EXECUTION_ARBITER_WINDOW_MS=25
# WARBITRER_ASSET_STARTUP_JITTER_MS=auto
# WARBITRER_COLD_SCAN_INTERVAL_MS=1000
# WARBITRER_HOT_SCAN_INTERVAL_MS=250
# WARBITRER_HOT_SIGNAL_TTL_MS=10000
# Executor wakes immediately after scans; this is only the idle fallback.
# WARBITRER_EXECUTION_IDLE_INTERVAL_MS=1000

# VPS memory safety net, not a CPU optimization:
# recommended prod ops: 2G swapfile + vm.swappiness=10
