DATABASE_URL=postgres://postgres:postgres@localhost:5432/warbitrer_live

# Kalshi live / demo
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# KALSHI_PRIVATE_KEY_PATH=/etc/warbitrer/kalshi-private-key.pem
# KALSHI_ENV=demo

# Polymarket
# POLY_PRIVATE_KEY=0x...
# POLY_PRIVATE_KEY_PATH=/etc/warbitrer/polymarket-private-key.txt
# Derived via: npm run poly:derive-api-key
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=
# POLY_FUNDER_ADDRESS=0x...
# POLY_SIGNATURE_TYPE=POLY_PROXY
# POLY_AUTO_REDEEM=false
# POLYGON_RPC_URL=https://polygon-rpc.com

# Strategy
# SHADOW MODE:
# - enableTrading=false, shadowMode=true  => scan only
# - enableTrading=true, shadowMode=true   => shadow execution
# - enableTrading=true, shadowMode=false  => live execution
# POLY_BRIDGE_LOW_WATER_USDC=250
