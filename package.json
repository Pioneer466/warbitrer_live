{
  "name": "warbitrer-live-btc15m",
  "version": "0.1.0",
  "private": true,
  "description": "Live multi-asset 15m arbitrage cockpit and worker for Kalshi and Polymarket",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@=./src --outfile=dist/worker/index.mjs",
    "start": "next start --hostname 0.0.0.0",
    "start:web": "next start --hostname 127.0.0.1",
    "start:render": "node scripts/start-render.mjs",
    "start:worker": "tsx src/worker/index.ts",
    "start:worker:asset": "tsx src/worker/index.ts --role asset-live",
    "start:worker:asset:prod": "node dist/worker/index.mjs --role asset-live",
    "start:worker:reconcile": "tsx src/worker/index.ts --role reconciler",
    "start:worker:reconcile:prod": "node dist/worker/index.mjs --role reconciler",
    "start:worker:notifications": "tsx src/worker/index.ts --role notifier",
    "start:worker:notifications:prod": "node dist/worker/index.mjs --role notifier",
    "start:worker:legacy": "tsx src/worker/index.ts --role legacy",
    "start:all": "concurrently -k -n web,worker -c cyan,magenta \"npm run start:web\" \"npm run start:worker\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "audit:prod": "node scripts/check-production-audit.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:repair-v8-legacy": "tsx scripts/repair-legacy-v8-preconditions.ts",
    "verify": "npm run audit:prod && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run build:worker",
    "poly:derive-api-key": "tsx scripts/polymarket-derive-api-key.ts",
    "incident:report": "node --import tsx ./scripts/incident-report.ts",
    "logs:events": "node --import tsx ./scripts/run-events.ts",
    "incident:doc": "node --import tsx ./scripts/incident-report.ts --markdown --output incident-report.md --max-intents 12",
    "intent:audit": "node --import tsx ./scripts/audit-intent.ts",
    "breaker:audit": "node --import tsx ./scripts/audit-breakers.ts",
    "slot:audit": "node --import tsx ./scripts/audit-slot.ts",
    "backtest:export-command": "node --import tsx ./scripts/backtest-export-command.ts",
    "backtest:import": "node --import tsx ./scripts/backtest-import.ts",
    "backtest:strategies": "node --import tsx ./scripts/backtest-strategies.ts",
    "mismatch:calibrate": "node --import tsx ./scripts/calibrate-mismatch-risk.ts",
    "mismatch:candidates": "node --import tsx ./scripts/analyze-mismatch-candidates.ts",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm run dev\" \"npm run worker:dev\""
  },
  "dependencies": {
    "@chainlink/data-streams-sdk": "^1.2.1",
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/clob-client-v2": "^1.1.0",
    "ethers": "^5.8.0",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "viem": "^2.55.4",
    "ws": "8.21.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.2",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.4.21",
    "concurrently": "10.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "8.5.20",
    "prettier": "^3.9.5",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.1",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "axios": "1.18.1",
    "follow-redirects": "1.16.0",
    "form-data": "4.0.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.20",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0",
    "vite": "6.4.3",
    "ws": "8.21.1"
  }
}
