DATABASE_URL=postgres://warbitrer:change-me@127.0.0.1:5432/warbitrer_live
# Minimum 2. Default split topology has 8 processes, so 3 means up to 24 app connections.
# Size PostgreSQL max_connections for app pools plus migrations, backups, and operator access.
PG_POOL_MAX=3
APP_BASIC_AUTH_USER=ops
APP_BASIC_AUTH_PASSWORD=change-me
LIVE_EXECUTION_ALLOWED=false
DB_MAINTENANCE_INTERVAL_MINUTES=60
DB_RETENTION_SNAPSHOTS_HOURS=72
DB_RETENTION_PNL_DAYS=30
DB_RETENTION_RUN_EVENTS_DAYS=30
DB_RETENTION_FILLS_DAYS=180
DB_RETENTION_ORDERS_DAYS=180
DB_RETENTION_CLOSED_INTENTS_DAYS=180
DB_RETENTION_SETTLEMENTS_DAYS=365
DB_RETENTION_BRIDGE_TRANSFERS_DAYS=365

# Kalshi
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/etc/warbitrer/kalshi-private-key.pem
KALSHI_ENV=demo

# Polymarket
POLY_PRIVATE_KEY_PATH=/etc/warbitrer/polymarket-private-key.txt
# Derive these three via: cd /opt/warbitrer-live/app && npm run poly:derive-api-key
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_RELAYER_API_KEY=
POLY_RELAYER_URL=https://relayer-v2.polymarket.com
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=POLY_PROXY
POLY_AUTO_CONVERT=false
POLY_AUTO_REDEEM=false
POLY_BRIDGE_LOW_WATER_USDC=250
POLYGON_RPC_URL=https://polygon-rpc.com

# Chainlink Data Streams direct (BNB/HYPE)
CHAINLINK_DATA_STREAMS_API_KEY=
CHAINLINK_DATA_STREAMS_USER_SECRET=

# Optional
PORT=3000
WARBITRER_COLD_SCAN_INTERVAL_MS=1000
WARBITRER_HOT_SCAN_INTERVAL_MS=250
WARBITRER_HOT_SIGNAL_TTL_MS=10000
WARBITRER_EXECUTION_IDLE_INTERVAL_MS=1000
