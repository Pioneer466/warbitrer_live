[Unit]
Description=Warbitrer Live Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=warbitrer
Group=warbitrer
WorkingDirectory=/opt/warbitrer-live/app
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/warbitrer/warbitrer.env
ExecStart=/usr/bin/npm run start:web
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=15
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
KillMode=control-group
SyslogIdentifier=warbitrer-web

[Install]
WantedBy=multi-user.target
