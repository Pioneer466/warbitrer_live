[Unit]
Description=Warbitrer Asset Worker %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=warbitrer
Group=warbitrer
WorkingDirectory=/opt/warbitrer-live/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/warbitrer/warbitrer.env
ExecStart=/usr/bin/npm run start:worker:asset:prod -- --asset %i
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=15
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
KillMode=control-group
SyslogIdentifier=warbitrer-asset-%i

[Install]
WantedBy=multi-user.target
