[Unit]
Description=Warbitrer Notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=warbitrer
Group=warbitrer
WorkingDirectory=/opt/warbitrer-live/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/warbitrer/warbitrer.env
ExecStart=/usr/bin/npm run start:worker:notifications:prod
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=15
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
KillMode=control-group
SyslogIdentifier=warbitrer-notifier

[Install]
WantedBy=multi-user.target
